{
  "version": 2,
  "payroll_margin_limit_pct": "80",
  "email_change_window_days": 7,
  "rules": [
    {
      "id": "G-01",
      "applies_to": "SEND_REMEDIATION_INVOICE",
      "when": {
        "amount_lte": "250.00",
        "confidence_gte": 0.9,
        "clause_quote_present": true
      },
      "outcome": "ALLOW",
      "source_text": "Send correction invoices on my own if they are $250 or less and the contract is clear."
    },
    {
      "id": "G-02",
      "applies_to": "SEND_REMEDIATION_INVOICE",
      "when": {
        "amount_gt": "250.00"
      },
      "outcome": "ASK",
      "source_text": "Send correction invoices on my own if they are $250 or less and the contract is clear."
    },
    {
      "id": "G-03",
      "applies_to": "SEND_REMEDIATION_INVOICE",
      "when": {
        "client_tag": "never_auto_contact"
      },
      "outcome": "ASK",
      "source_text": "Always ask me first for clients tagged never_auto_contact"
    },
    {
      "id": "G-04",
      "applies_to": "SEND_REMEDIATION_INVOICE",
      "when": {
        "invoiced_same_client_within_days": 7
      },
      "outcome": "ASK",
      "source_text": "or if we already invoiced them this week."
    },
    {
      "id": "G-05",
      "applies_to": "SEND_REMEDIATION_INVOICE",
      "when": {
        "line_items_sum_mismatch": true
      },
      "outcome": "DENY",
      "source_text": "(built in)"
    }
  ],
  "activated_at": "2026-11-05T10:02:11Z"
}
