# The Financial Detective — environment template. Copy to .env and fill in.
# NEVER commit a real .env (it is git-ignored). Placeholders only here.

# --- PayPal Sandbox (server-side only; never expose the secret to the browser) ---
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id_here
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com

# --- App / DB ---
ENV=local_test
ENABLE_DEV_ROUTES=false
DATABASE_URL=sqlite:///./financial_detective.db
FRONTEND_ORIGIN=http://localhost:5173

# --- LLM providers (P2) ---
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- Frontend (Vite) ---
# build against mock fixtures until the Day 17 switchover
VITE_USE_MOCKS=true
VITE_API_BASE_URL=http://localhost:8000/api/v1
