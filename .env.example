# The Financial Detective — environment template (plan Rev 2.3, Appendix A.1).
# Copy to .env and fill in. NEVER commit a real .env (it is git-ignored).

# --- PayPal sandbox (server-side only; never expose the secret to the browser) ---
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id_here
# Startup refuses any value other than the sandbox base URL.
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com

# --- App / database ---
DATABASE_URL=sqlite:///./fd.db
# 24+ random characters; every write needs X-Demo-Key (except the PayPal webhook).
DEMO_KEY=replace_with_24_plus_random_characters
CORS_ORIGINS=http://localhost:5173
LEASH_ENABLED=true
SEED_DEMO_DATA=false
LOG_LEVEL=INFO

# --- Payroll (Payouts status polling) ---
PAYOUTS_POLL_SECONDS=10
PAYOUTS_POLL_MAX_SECONDS=120

# --- AI providers (at least one key; both enable the fallback chain) ---
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_PRIMARY_MODEL=gemini-2.5-flash
AI_FALLBACK_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20

# --- Frontend (Vite: compiled into public JavaScript — never put secrets here) ---
VITE_USE_MOCKS=true
VITE_API_BASE_URL=http://localhost:8000
